# Bu dosya bir SABLONDUR - gercek deger icermez ve git'e commit'lenir.
# Kullanim:  cp .env.example .env   ardindan .env icini kendi degerlerinizle doldurun.
# .env dosyasi .gitignore tarafindan engellenir, asla commit'lenmemelidir.

# Supabase proje URL'i (Dashboard > Project Settings > Data API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SECRET (service) key - Dashboard > Project Settings > API Keys
# DIKKAT: Bu anahtar Row Level Security'yi tamamen bypass eder ve tam admin
# yetkisine sahiptir. Sadece sunucu tarafinda kullanilir, tarayiciya/istemciye
# ASLA gonderilmez ve log'lanmaz. Sizdigindan suphelenirseniz derhal rotate edin.
SUPABASE_SERVICE_KEY=sb_secret_replace_me

# demo_kullanici_uret.py ile olusturulan demo hesaplarin sifresi
DEMO_USER_PASSWORD=DemoSifre123!

# Guvenlik kilidi: demo_kullanici_uret.py gercek bir veritabanina admin
# yetkisiyle yazar. Interaktif onayi atlamak icin (orn. CI) "true" yapin.
DEMO_SEED_ONAY=false

# Opsiyonel: vLLM RunPod GPU'da calisiyor. SSH tuneliyle localhost:8000'e
# yonlendiriyorsaniz bu satirlari YORUM SATIRI olarak birakin (varsayilan
# zaten http://localhost:8000/v1). RunPod'un HTTP proxy'sini kullaniyorsaniz
# tam URL'i yazin.
# VLLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
# VLLM_API_KEY=EMPTY
# VLLM_MODEL_ADI=Qwen/Qwen2.5-32B-Instruct-AWQ
